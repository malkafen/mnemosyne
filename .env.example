# Private SSH key of every group without a `key` of its own (--key);
# a group's `key` in the inventory wins. compose.yml mounts HV_KEY_FILE here.
MNEM_KEY=/run/secrets/hv_key

# Port of the cloud-init seed server (--http-port). The inventory's metaUrl must
# point at it: http://<this host>:<port>/cloud-init/. Default: 8080.
MNEM_HTTP_PORT=

# How many VMs of a group to apply at once (--parallel). Default: 1.
MNEM_PARALLEL=

# true = do NOT verify the hypervisors' SSH host keys (--no-verify).
# Unsafe outside a throwaway lab. Default: verify against known_hosts.
MNEM_NO_VERIFY=

# ----- Compose only: host side, never seen by Mnemosyne ----------------------

# The inventory file; mounted read-only at /etc/mnemosyne/servers.yml.
INVENTORY_FILE=./configs/servers.yml

# Private SSH key the hypervisors accept; mounted at /run/secrets/hv_key.
HV_KEY_FILE=/home/example/.ssh/id_ed25519

# known_hosts with every hypervisor's host key; an unknown key fails the connection.
KNOWN_HOSTS_FILE=/home/example/.ssh/known_hosts
